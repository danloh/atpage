{
  "lexicon": 1,
  "id": "one.atpage.page",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["links", "services"],
        "properties": {
          "title": {
            "type": "string",
            "description": "title of the atpage"
          },
          "description": {
            "type": "string",
            "description": "description of the atpage"
          },
          "style": {
            "type": "string",
            "description": "customized style of the atpage"
          },
          "script": {
            "type": "string",
            "description": "Injected JaveScript of the atpage"
          },
          "services": {
            "type": "array",
            "description": "list of atproto services to display",
            "items": {
              "type": "string",
              "description": "name of the atproto service"
            }
          },
          "links": {
            "type": "array",
            "description": "a list of links to display",
            "items": {
              "type": "ref",
              "ref": "#link"
            }
          },
          "follows": {
            "type": "array",
            "description": "list of follows to display (TODO)",
            "items": {
              "type": "ref",
              "ref": "#follow"
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "description": "Represents a single link",
      "required": ["url", "name"],
      "properties": {
        "url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "URL of the icon"
        },
        "style": {
          "type": "string",
          "description": "style of the link"
        },
        "createdAt": {
          "type": "integer",
          "format": "timestamp(sec)"
        }
      }
    },
    "follow": {
      "type": "object",
      "description": "Represents a single follow",
      "required": ["did", "createdAt"],
      "properties": {
        "did": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer",
          "format": "timestamp(sec)"
        }
      }
    }
  }
}
